{
  "name": "mysql-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Secure direct MySQL connection layer for an MCP server.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.test.json --noEmit",
    "lint": "npm run check && eslint src test",
    "lint:fix": "prettier --write --ignore-path .gitignore . && eslint src test --fix",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore .",
    "test": "tsx --test test/unit",
    "test:integration": "node -e \"if (process.env.MYSQL_INTEGRATION_TEST !== 'true') throw new Error('Set MYSQL_INTEGRATION_TEST=true to run integration tests.');\" && tsx --test test/integration"
  },
  "dependencies": {
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  }
}
