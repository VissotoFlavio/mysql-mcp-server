# Copy this file to a local, untracked .env file and set values only on your machine.
# Never commit values, connection strings, or TLS material.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Opt in to DML; reuse the existing MYSQL_USER and MYSQL_PASSWORD credentials.
MYSQL_DML_ENABLED=false
MYSQL_POOL_LIMIT=
MYSQL_QUEUE_LIMIT=
MYSQL_CONNECT_TIMEOUT_MS=
MYSQL_QUERY_TIMEOUT_MS=
MYSQL_IDLE_TIMEOUT_MS=
MYSQL_TLS=
MYSQL_TLS_CA_FILE=
MYSQL_TLS_CERT_FILE=
MYSQL_TLS_KEY_FILE=
MYSQL_INTEGRATION_SCHEMA=
MYSQL_INTEGRATION_TABLE=
