# Copy this file to a local, untracked .env file and set values only on your machine.
# Never commit values, connection strings, or TLS material.
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Optional connection settings. Leave unset to use the documented defaults.
# MYSQL_PORT=3306
# MYSQL_POOL_LIMIT=2
# MYSQL_QUEUE_LIMIT=10
# MYSQL_CONNECT_TIMEOUT_MS=5000
# MYSQL_QUERY_TIMEOUT_MS=30000
# MYSQL_IDLE_TIMEOUT_MS=60000
# MYSQL_TLS=false
# MYSQL_TLS_REJECT_UNAUTHORIZED=true
# MYSQL_TLS_CA_FILE=/absolute/path/to/ca.pem
# MYSQL_TLS_CERT_FILE=/absolute/path/to/client-cert.pem
# MYSQL_TLS_KEY_FILE=/absolute/path/to/client-key.pem

# Opt in to DML; reuse the existing MYSQL_USER and MYSQL_PASSWORD credentials.
MYSQL_DML_ENABLED=false
# Opt in only to controlled create_schema, create_table, create_view, drop_view, create_index, create_unique_index, drop_index, drop_table, drop_schema, truncate_table, alter_table_add_column, alter_table_add_foreign_key, alter_table_drop_foreign_key, alter_table_drop_column, alter_table_modify_column, alter_table_rename_column, and rename_table DDL; reuse the existing MYSQL_USER and MYSQL_PASSWORD credentials.
MYSQL_DDL_ENABLED=false
# Separate strict opt-in for create_schema; this remains unavailable unless MYSQL_DDL_ENABLED is also true.
MYSQL_DDL_CREATE_SCHEMA_ENABLED=false
# Explicitly attest that the account can see all possible dependent views and referenced objects before enabling drop_view.
MYSQL_DDL_DROP_VIEW_METADATA_COMPLETE=false
# Separate strict destructive opt-in for alter_table_drop_column; this remains unavailable unless MYSQL_DDL_ENABLED is also true.
MYSQL_DDL_DROP_COLUMN_ENABLED=false
MYSQL_DDL_DROP_COLUMN_METADATA_COMPLETE=false
# Separate strict destructive opt-in for drop_table; this remains unavailable unless MYSQL_DDL_ENABLED is also true.
MYSQL_DDL_DROP_TABLE_ENABLED=false
MYSQL_DDL_DROP_TABLE_METADATA_COMPLETE=false
# Separate strict destructive opt-in for drop_schema; this remains unavailable unless MYSQL_DDL_ENABLED is also true.
MYSQL_DDL_DROP_SCHEMA_ENABLED=false
# Required exact comma-separated schema allowlist for drop_schema; never include MYSQL_DATABASE.
# MYSQL_DDL_DROP_SCHEMA_ALLOWLIST=disposable_schema

# Separate strict destructive opt-in for truncate_table; this remains unavailable unless MYSQL_DDL_ENABLED is also true.
MYSQL_DDL_TRUNCATE_TABLE_ENABLED=false
MYSQL_DDL_TRUNCATE_TABLE_METADATA_COMPLETE=false

# Integration-only values. Keep these unset except during an explicitly authorized
# run against an isolated disposable database. Never copy real credentials here.
# MYSQL_INTEGRATION_SCHEMA=isolated_schema
# MYSQL_INTEGRATION_TABLE=mcp_ddl_test_example
# MYSQL_INTEGRATION_TEST=true
# MYSQL_DML_INTEGRATION_TEST=true
# MYSQL_DML_INTEGRATION_CONFIRM=isolated-database-dml
# MYSQL_DML_INTEGRATION_TABLE=mcp_ddl_test_example
# MYSQL_DDL_INTEGRATION_TEST=true
# MYSQL_DDL_INTEGRATION_CONFIRM=isolated-database-schema
# MYSQL_DDL_INTEGRATION_TABLE=mcp_ddl_test_example
# MYSQL_DDL_DROP_TABLE_INTEGRATION_TABLE=mcp_ddl_test_drop_table
# MYSQL_DDL_TRUNCATE_TABLE_INTEGRATION_TABLE=mcp_ddl_test_truncate_table
# MYSQL_DDL_CREATE_SCHEMA_INTEGRATION_TEST=true
# MYSQL_DDL_CREATE_SCHEMA_INTEGRATION_CONFIRM=isolated-schema-create-drop
# MYSQL_DDL_DROP_SCHEMA_INTEGRATION_TEST=true
# MYSQL_DDL_DROP_SCHEMA_INTEGRATION_CONFIRM=isolated-schema-create-drop
# MYSQL_DDL_DROP_SCHEMA_INTEGRATION_SCHEMA=mcp_ddl_test_schema
